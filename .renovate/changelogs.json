{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Changelog URL for Cloudflared",
      "matchPackageNames": ["mirror.gcr.io/cloudflare/cloudflared"],
      "changelogUrl": "https://github.com/cloudflare/cloudflared/blob/master/RELEASE_NOTES"
    },
    {
      "description": "Changelog URL for ActualBudget",
      "matchPackageNames": ["ghcr.io/actualbudget/actual-server"],
      "changelogUrl": "https://actualbudget.org/blog/release-{{newVersion}}"
    },
    {
      "description": "Match Reloader helm chart release tags for release notes",
      "matchPackageNames": ["ghcr.io/stakater/charts/reloader"],
      "extractVersion": "^(?:chart-v)?(?<version>\\d.*)$"
    },
    {
      "description": "Match External-DNS helm chart release tags for release notes",
      "matchPackageNames": ["registry.k8s.io/external-dns/charts/external-dns"],
      "extractVersion": "^(?:external-dns-helm-chart-)?(?<version>\\d.*)$"
    }
  ]
}
